---
import '../styles/fonts.css';
import '../styles/theme.css';
import '../styles/dashboard.css';
import { CHART_SCALES, DEFAULT_CHART_SCALE } from '../scripts/page-chart-scale.js';
import { THEMES } from '../scripts/themes.js';
const canSignOut = Astro.cookies.has('saga_fe_session');
---
<!doctype html>
<html lang="en" data-theme="bjornarhagen" data-mode="dark" data-mode-preference="dark" data-motion-preference="system" data-chart-scale-default={DEFAULT_CHART_SCALE} data-chart-scale-options={CHART_SCALES.map(scale => scale.id).join(',')} data-theme-options={THEMES.map(theme => theme.id).join(',')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content="Saga Fé — a local ledger for personal spending, cash flow, and the months ahead." />
    <title>Saga Fé — Personal ledger</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/jetbrains-mono/jetbrains-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pirata-one/pirata-one.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-shell">
      <header class="site-header">
        <a class="brand" href="#overview" aria-label="Saga Fé home"><span class="brand-sigil" aria-hidden="true"></span><span>Saga <span class="brand-name">Fé</span></span></a>
        <div class="identity"><span class="local-dot"></span> PERSONAL LEDGER <span class="status-sep">/</span> PRIVATE</div>
        <div class="header-actions">
          <details id="appearance-control" class="appearance-control">
            <summary class="chrome-button" aria-label="Appearance settings"><span class="appearance-glyph" aria-hidden="true">◈</span><span class="appearance-label">Appearance</span></summary>
            <div class="appearance-panel">
              <div class="appearance-title">Appearance</div>
              <label for="theme-select">Theme</label>
              <select id="theme-select" aria-describedby="theme-description">
                {THEMES.map(theme => <option value={theme.id}>{theme.label}</option>)}
              </select>
              <p id="theme-description" class="appearance-description">{THEMES[0].description}</p>
              <label for="mode-select">Mode</label>
              <select id="mode-select" aria-describedby="mode-description">
                <option value="dark">Dark</option>
                <option value="light">Light</option>
                <option value="system">Follow system</option>
              </select>
              <p id="mode-description" class="appearance-description">Follow system uses your device’s light or dark setting. Preferences stay in this browser.</p>
              <label for="motion-select">Motion</label>
              <select id="motion-select" aria-describedby="motion-description">
                <option value="system">Follow system</option>
                <option value="full">Full motion</option>
                <option value="reduce">Reduced motion</option>
              </select>
              <p id="motion-description" class="appearance-description">Follow system uses your device’s motion preference. Reduced motion shows numbers immediately and turns off transitions.</p>
              <label for="default-chart-scale-select">Default chart scale</label>
              <select id="default-chart-scale-select" aria-describedby="default-chart-scale-description">
                {CHART_SCALES.map(scale => <option value={scale.id} selected={scale.id === DEFAULT_CHART_SCALE}>{scale.label}</option>)}
              </select>
              <p id="default-chart-scale-description" class="appearance-description">Used when a page’s Chart scale is set to Default. You can override it on each page. Preferences stay in this browser.</p>
            </div>
          </details>
          <button id="import-button" class="chrome-button" aria-label="Import ledger data">↑ <span>Import data</span></button>
          {canSignOut && <button id="sign-out" class="chrome-button">Sign out</button>}
          <input id="csv-input" type="file" accept=".csv,.json,text/csv,application/json" hidden />
        </div>
      </header>
      <nav class="room-nav" aria-label="Main navigation">
        <button class="nav active" data-view="overview"><span class="nav-key" aria-hidden="true">01</span> Overview</button>
        <button class="nav" data-view="forecast"><span class="nav-key" aria-hidden="true">02</span> Look ahead</button>
        <button class="nav" data-view="transactions"><span class="nav-key" aria-hidden="true">03</span> Transactions</button>
        <button class="nav" data-view="accounts"><span class="nav-key" aria-hidden="true">04</span> Accounts</button>
        <button class="nav" data-view="data"><span class="nav-key" aria-hidden="true">05</span> Data & method</button>
      </nav>
      <main id="main-content" tabindex="-1">
        <div class="topbar"><span class="breadcrumb">~ <span class="status-sep">/</span> personal <span class="status-sep">/</span> <span id="topbar-view">Overview</span></span><span id="data-status" class="data-status">Reading your ledger…</span></div>
        <div id="error" class="error-banner" role="alert" hidden></div>
        <div id="loading" class="loading"><span aria-hidden="true">[ … ]</span> Reading your ledger…</div>
        <div id="content" hidden><slot /></div>
      </main>
      <footer class="status-footer"><span><span class="local-dot"></span> YOUR MONEY STAYS HERE</span><span>NOK <span class="status-sep">/</span> <span id="footer-date"></span></span><span id="save-status" role="status">Saved in private ledger</span><span class="footer-brand">SAGA / FÉ</span></footer>
    </div>
    <slot name="dialog" />
    <dialog id="account-dialog"><form id="new-account-form"><div class="dialog-heading"><h2>Add account</h2><button id="close-account-dialog" type="button" class="icon-button" aria-label="Close account dialog">×</button></div><label>Account name<input id="new-account-name" maxlength="200" required /></label><label>Use in forecast<select id="new-account-role"><option value="available">Available cash</option><option value="reserve">Savings reserve</option><option value="excluded">Excluded</option></select></label><label>Balance in NOK<input id="new-account-balance" type="number" step="0.01" placeholder="Leave blank if unknown" /></label><label>Balance date<input id="new-account-date" type="date" required /></label><p class="input-note">You can add an account without transactions, including savings held elsewhere.</p><div class="dialog-actions"><span class="muted small">Currency: NOK</span><button type="submit" class="primary-button">Add account</button></div></form></dialog>
    <div id="toast" class="toast" role="status" hidden></div>
    <script src="../scripts/dashboard.js"></script>
    <script>
      import { initializeThemes } from '../scripts/themes.js';
      initializeThemes();
    </script>
  </body>
</html>
