<dialog id="edit-dialog" aria-labelledby="edit-title"><form id="edit-form"><div class="dialog-heading"><h2 id="edit-title">Review transaction</h2><button type="button" id="close-dialog" class="icon-button" aria-label="Close">×</button></div><p id="edit-description"></p><p id="edit-meta" class="muted small"></p><div id="edit-category-suggestion" class="category-assistance"></div><label>Classify as<select id="edit-kind"><option value="expense">Spending</option><option value="income">Money in</option><option value="saving">External savings / investment</option><option value="transfer">Transfer between my own accounts</option></select></label><label>Category<input id="edit-category" list="category-options" required maxlength="200"><datalist id="category-options"></datalist></label><label class="checkbox edit-checkbox"><input id="edit-exclude" type="checkbox"> Exclude from forecast averages (one-off)</label><p class="input-note">Historical totals still include one-off payments. A transfer is excluded from both income and spending. Reclassification does not change the amount's sign.</p><div class="dialog-actions"><button id="reset-transaction" type="button" class="text-button">Reset this transaction</button><button type="submit" class="primary-button">Save changes</button></div></form></dialog>
<dialog id="similar-category-dialog" aria-labelledby="similar-category-title">
  <div class="dialog-heading"><h2 id="similar-category-title">Apply to similar payments?</h2><button type="button" id="close-similar-category" class="icon-button" aria-label="Close similar payments">×</button></div>
  <p id="similar-category-description"></p>
  <p class="input-note">Matches use the same sender or receiver, payment type and direction across all history. Amount filters use the payment size in NOK. Only the category decision is copied.</p>
  <div class="similar-amount-filters"><label>Minimum amount (NOK)<input id="similar-min-amount" type="text" inputmode="decimal" placeholder="No minimum"></label><label>Maximum amount (NOK)<input id="similar-max-amount" type="text" inputmode="decimal" placeholder="No maximum"></label></div>
  <label class="checkbox"><input id="similar-include-categorized" type="checkbox"> Also include existing categories and user decisions</label>
  <p id="similar-category-status" role="status" aria-live="polite" class="input-note"></p>
  <p id="similar-category-error" role="alert" class="detail-status"></p>
  <div class="similar-select-actions"><button type="button" id="similar-select-all" class="text-button">Select all matches</button><button type="button" id="similar-select-none" class="text-button">Clear selection</button><button type="button" id="similar-refresh" class="text-button">Refresh matches</button></div>
  <div class="table-scroll similar-payment-list"><table><caption class="sr-only">Matching payments and their current categories</caption><thead><tr><th scope="col">Select</th><th scope="col">Payment</th><th scope="col">Category</th><th scope="col" class="numeric">Amount</th></tr></thead><tbody id="similar-category-rows"></tbody></table></div>
  <div class="dialog-actions"><button type="button" id="skip-similar-category" class="outline-button">Done</button><button type="button" id="apply-similar-category" class="primary-button">Apply to selected</button></div>
</dialog>
