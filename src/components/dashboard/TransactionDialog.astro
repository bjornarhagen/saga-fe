<dialog id="edit-dialog"><form id="edit-form"><div class="dialog-heading"><h2>Review transaction</h2><button type="button" id="close-dialog" class="icon-button" aria-label="Close">×</button></div><p id="edit-description"></p><p id="edit-meta" class="muted small"></p><label>Classify as<select id="edit-kind"><option value="expense">Spending</option><option value="income">Money in</option><option value="saving">External savings / investment</option><option value="transfer">Transfer between my own accounts</option></select></label><label>Category<input id="edit-category" list="category-options" required maxlength="100"><datalist id="category-options"></datalist></label><label class="checkbox edit-checkbox"><input id="edit-exclude" type="checkbox"> Exclude from forecast averages (one-off)</label><p class="input-note">Historical totals still include one-off payments. A transfer is excluded from both income and spending. Reclassification does not change the amount's sign.</p><div class="dialog-actions"><button id="reset-transaction" type="button" class="text-button">Reset this transaction</button><button type="submit" class="primary-button">Save changes</button></div></form></dialog>
