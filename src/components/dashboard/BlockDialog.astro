<dialog id="block-dialog" aria-labelledby="block-dialog-title" aria-describedby="block-dialog-note">
  <div class="dialog-heading"><h2 id="block-dialog-title"></h2><button id="close-block-dialog" type="button" class="icon-button" aria-label="Close expanded view" autofocus>×</button></div>
  <p id="block-dialog-note" class="input-note">Options apply only to this expanded view. The page stays as you left it. Closing discards these options.</p>
  <div id="block-dialog-options" class="block-dialog-options"></div>
  <div class="block-dialog-toolbar"><button id="reset-block-dialog" type="button" class="text-button">↺ Reset view options</button></div>
  <div id="block-dialog-content"></div>
</dialog>
