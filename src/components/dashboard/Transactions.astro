<section id="transactions-view" class="view" hidden>
  <header class="page-heading"><div><p class="eyebrow">03 / TRANSACTION LEDGER</p><h1>Follow the money.</h1><p class="subtitle">Explore your transactions and fine-tune what counts in your forecast.</p></div><button id="export-button" class="outline-button">↓ Export filtered CSV</button></header>
  <article class="card transaction-card"><div class="filters"><label class="search-label">Search<input id="search" type="search" placeholder="Search a payment or category…"></label><label>Category<select id="category-filter"><option value="">All categories</option></select></label><label>Type<select id="kind-filter"><option value="">All types</option><option value="expense">Spending</option><option value="income">Money in</option><option value="saving">External savings</option><option value="transfer">Internal transfers</option></select></label><label>Period<select id="transaction-period"><option value="selected">Overview period</option><option value="all">All history</option></select></label></div><div class="table-toolbar"><label class="checkbox"><input id="review-only" type="checkbox"> Needs review only</label><label class="checkbox"><input id="excluded-only" type="checkbox"> Excluded from forecast</label><label class="sort-label"><span class="sr-only">Sort transactions</span><select id="transaction-sort" aria-label="Sort transactions"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="outflow">Largest outflows</option><option value="inflow">Largest inflows</option></select></label><span id="transaction-count" class="muted small"></span><button id="clear-filters" class="text-button">Clear filters</button></div><div class="table-scroll"><table><thead><tr><th>Date</th><th>Payment</th><th>Category</th><th>Type</th><th class="numeric">Amount</th><th><span class="sr-only">Edit</span></th></tr></thead><tbody id="transaction-rows"></tbody></table></div><div class="pagination"><span id="page-label" class="muted small"></span><div><button id="previous-page" class="outline-button">← Previous</button><button id="next-page" class="outline-button">Next →</button></div></div></article>
</section>
