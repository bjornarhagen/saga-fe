---
import AsciiLabLayout from '../../layouts/AsciiLabLayout.astro';
import SpecimenSuite from '../../components/ascii-lab/SpecimenSuite.astro';
import { LAB_METHODS } from '../../lib/ascii-lab.js';
const method = LAB_METHODS.find(item => item.id === Astro.params.method);
if (!method) return Astro.redirect('/ascii-lab');
---
<AsciiLabLayout method={method}><SpecimenSuite method={method} /></AsciiLabLayout>
