---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Overview from '../components/dashboard/Overview.astro';
import Forecast from '../components/dashboard/Forecast.astro';
import Transactions from '../components/dashboard/Transactions.astro';
import DataMethod from '../components/dashboard/DataMethod.astro';
import TransactionDialog from '../components/dashboard/TransactionDialog.astro';
import Accounts from '../components/dashboard/Accounts.astro';
import TransactionDetail from '../components/dashboard/TransactionDetail.astro';
import AccountDetail from '../components/dashboard/AccountDetail.astro';
import BlockDialog from '../components/dashboard/BlockDialog.astro';
---
<DashboardLayout>
  <Overview />
  <Forecast />
  <Transactions />
  <Accounts />
  <TransactionDetail />
  <AccountDetail />
  <DataMethod />
  <Fragment slot="dialog"><TransactionDialog /><BlockDialog /></Fragment>
</DashboardLayout>
